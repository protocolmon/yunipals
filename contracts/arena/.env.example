# PUBLIC settings only. Never put a private key or keystore password in this file.
# Economics approved in config/launch-economics.json.
# Fill remaining addresses, timeouts, VRF cap and rules hash before deployment.
ARENA_DEPLOYER=
ARENA_ADMIN=
ARENA_LOBBY_OPERATOR=
ARENA_ADMISSION_SIGNER=
ARENA_REFEREE=
# Treasury starts at ARENA_DEPLOYER. The owner can call setTreasury for future lobbies.
# Native USDC on Base: six decimals; 2 USDC per participant.
ARENA_PAYMENT_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ARENA_ENTRY_FEE_RAW=2000000
ARENA_WINNER_BPS=7500
ARENA_ISLAND_BPS=500
# Full tournament: winner 6 USDC, island owner 0.40 USDC, treasury 1.60 USDC.
# Treasury receives the remaining 2,000 bps, including any rounding dust.
# Seven days from first paid entry; twenty-four hours from roster/island readiness.
ARENA_JOIN_WINDOW_SECONDS=604800
ARENA_STRATEGY_WINDOW_SECONDS=86400
ARENA_RESOLUTION_WINDOW_SECONDS=86400
ARENA_MAX_VRF_COST_WEI=
ARENA_RULES_SHA256=
# Existing budgeted Base RPC on yunipals-main; no provider key required here.
BASE_RPC_URL=http://127.0.0.1:19202
