-- capacity_sampler: capacityWorker.ts
GRANT USAGE ON SCHEMA yunipals_arena TO "yunipals_arena_native_capacity";
GRANT SELECT ON TABLE yunipals_arena.deployment TO "yunipals_arena_native_capacity";
GRANT SELECT ON TABLE yunipals_arena.operational_migration TO "yunipals_arena_native_capacity";
