# Private production configuration. Actual file: /etc/yunipals-arena/arena.env
# Keep the actual file owned by root, mode 0600. Never put these values in VITE_*.
OPENAI_API_KEY=
RUNWARE_API_KEY=
## Non-secret service configuration belongs in runtime.env; see runtime.env.example.
# Separate lifetime ceiling for cached anatomy checks before entry, in micro-USD.
# Applied only with ARENA_OPENAI_FUNDING_MODE=capped. Ongoing mode keeps the
# fixed request, ownership, 20-per-wallet/day and 64-pending-job limits instead.
# In capped mode zero disables new calls; raise only against funded operations.
ARENA_IDENTITY_ALLOWANCE_MICROUSD=0
ARENA_IDENTITY_ALLOWANCE_UNTIL=
