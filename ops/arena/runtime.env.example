# Runtime configuration for API/projector. Do not add provider or admin credentials.
# Database credentials are loaded separately from database.env.
ARENA_PUBLIC_ORIGIN=https://www.yunipals.com
ARENA_PORT=53911
ARENA_REPOSITORY_ROOT=/srv/yunipals-arena/current
ARENA_CONTRACT=
ARENA_DEPLOYMENT_BLOCK=
ARENA_RULES_HASH=
ARENA_ENTRIES_ENABLED=false
# Keep the first paid test restricted; switch to public only after real acceptance.
ARENA_LAUNCH_MODE=pilot
ARENA_PILOT_WALLETS=
# Server-to-server metadata reads avoid public browser-protection checks.
ARENA_INDEXER_INTERNAL_URL=http://127.0.0.1:9011
# L2 execution cap only; Base L1 data fees and signer funding are checked before launch.
ARENA_MAX_SETTLEMENT_EXECUTION_FEE_WEI=10000000000000
ARENA_MAX_CONTROL_EXECUTION_FEE_WEI=10000000000000
# Systemd supplies service-specific secret file paths through LoadCredential.
# Private job files plus a separate, allowlisted publication subtree. No Nginx alias here.
ARENA_MEDIA_ROOT=/var/lib/yunipals-arena/media
# Default to the capped pilot. Set ongoing only when continuous provider billing
# is authorized; that mode ignores the two pilot fields below and their expiry.
# Per-battle generation limits, recorded usage and real capacity checks still apply.
ARENA_OPENAI_FUNDING_MODE=capped
# Fail closed until the operator explicitly allocates prefunded OpenAI credits.
# Cumulative ceiling includes previous referee reservations for this deployment.
# Renew the timestamp/allowance after checking the actual OpenAI billing dashboard.
ARENA_OPENAI_CREDIT_BUDGET_MICROUSD=0
ARENA_OPENAI_BUDGET_EXPIRES_AT=1970-01-01T00:00:00Z
ARENA_NEW_LOBBIES_ENABLED=false
# Only eth_sendRawTransaction uses this public endpoint. All reads retain CU limits.
ARENA_BROADCAST_RPC_URL=https://mainnet.base.org

# Application media allocation. Preserve all retained films; close new admission when
# the remaining allocation cannot cover queued films (3 GiB each, minimum 6 GiB).
ARENA_MEDIA_QUOTA_BYTES=21474836480
ARENA_MEDIA_RESERVED_BYTES=6442450944
