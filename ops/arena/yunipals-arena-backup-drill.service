[Unit]
Description=Yunipals Arena backup and isolated storage-box restore test
After=network-online.target postgresql@16-yunipals_market_production.service
Wants=network-online.target
Requires=postgresql@16-yunipals_market_production.service
OnFailure=yunipals-arena-backup-monitor.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/yunipals-arena/backup.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /srv/yunipals-arena/operations/backup.py --drill
TimeoutStartSec=45m
TimeoutStopSec=60s
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yunipals-arena/backups
MemoryMax=768M
TasksMax=96
