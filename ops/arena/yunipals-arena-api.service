[Unit]
Description=Yunipals Arena private intake and public API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yunipals-arena
Group=yunipals-arena
WorkingDirectory=/srv/yunipals-arena/current/apps/yunipals-market-api
EnvironmentFile=/etc/yunipals-arena/runtime.env
EnvironmentFile=/etc/yunipals-arena/database.env
LoadCredential=strategy-encryption.key:/etc/yunipals-arena/strategy-encryption.key
LoadCredential=admission.key:/etc/yunipals-arena/admission.key
ExecStart=/usr/bin/env ARENA_ENCRYPTION_KEY_FILE=%d/strategy-encryption.key ARENA_ADMISSION_KEY_FILE=%d/admission.key /srv/yunipals-arena/runtime/node-v24.18.1 dist/arena-server.mjs
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
