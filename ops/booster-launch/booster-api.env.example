# Public example only. Copy to your own protected environment file and configure
# an existing read-only PostgreSQL peer role; no password or API key is needed.
DATABASE_URL=postgresql:///yunipals_backfill?host=/var/run/postgresql&user=yunipals_unified_collector
BOOSTER_DATABASE_SCHEMA=yunipals_boosters_launch_v1
BOOSTER_API_PORT=9030
BOOSTER_ARTWORK_DIRECTORY=/var/lib/yunipals-booster-artwork
BOOSTER_ARTWORK_CATALOGS=base-mainnet-smoke-v1,base-mainnet-standard-v1
