-- REVIEWED PROPOSAL ONLY; unchanged finite source template grant list.
-- Review on the candidate source DB as owner before installation.
-- Creates the exact fresh NOLOGIN arena_native_reader. No LOGIN/password change.
-- Existing source database PUBLIC CONNECT/TEMP and function rights are
-- historical facts only. New ambient metadata is bound by a separate actual catalog; this file does not revoke PUBLIC rights.
-- This role has no operational/private strategy or signer access.
BEGIN;
SET LOCAL lock_timeout='2s';
SET LOCAL statement_timeout='15s';
DO $arena_source$
BEGIN
 IF current_database()<>'yunipals_backfill' OR current_setting('port')<>'5432'
 THEN RAISE EXCEPTION 'fixed_arena_source_target_changed'; END IF;
 IF (SELECT oid FROM pg_database WHERE datname=current_database()) IS DISTINCT FROM 17584::oid
 OR (SELECT oid FROM pg_namespace WHERE nspname='unified_ypal_20261023_v1') IS DISTINCT FROM 75963410::oid
 OR (SELECT oid FROM pg_namespace WHERE nspname='yunipals_indexer_control') IS DISTINCT FROM 73011094::oid
 THEN RAISE EXCEPTION 'current_source_namespace_identity_changed'; END IF;
 IF EXISTS(SELECT 1 FROM(VALUES ('unified_ypal_20261023_v1._ponder_checkpoint',75963418),('unified_ypal_20261023_v1._ponder_meta',75963411),('unified_ypal_20261023_v1.arena_credit',75963726),('unified_ypal_20261023_v1.arena_tournament',75963696),('unified_ypal_20261023_v1.canonical_event',75963666),('unified_ypal_20261023_v1.chain_block',75963636),('unified_ypal_20261023_v1.chain_checkpoint',75963621),('unified_ypal_20261023_v1.indexer_source',75963651),('unified_ypal_20261023_v1.transaction_candidate',75963681),('yunipals_indexer_control.chain_anchor',73011156),('yunipals_indexer_control.chain_status',73011132),('yunipals_indexer_control.release',73011103),('yunipals_indexer_control.transaction_evidence',73011148))e(name,oid) LEFT JOIN pg_class c ON c.oid=e.oid AND c.oid=to_regclass(e.name)WHERE c.oid IS NULL OR c.relkind<>'r'OR c.relrowsecurity)
 THEN RAISE EXCEPTION 'current_13_source_relation_graph_changed'; END IF;
 IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='arena_native_reader')
 THEN RAISE EXCEPTION 'fresh_arena_source_role_name_already_present'; END IF;
END $arena_source$;
CREATE ROLE arena_native_reader NOLOGIN PASSWORD NULL NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 32;
GRANT CONNECT ON DATABASE yunipals_backfill TO arena_native_reader;
GRANT USAGE ON SCHEMA "unified_ypal_20261023_v1",yunipals_indexer_control
  TO "arena_native_reader";
GRANT SELECT ON "unified_ypal_20261023_v1"._ponder_meta,"unified_ypal_20261023_v1"._ponder_checkpoint,
  "unified_ypal_20261023_v1".indexer_source,"unified_ypal_20261023_v1".chain_checkpoint,
  "unified_ypal_20261023_v1".chain_block,"unified_ypal_20261023_v1".canonical_event,
  "unified_ypal_20261023_v1".transaction_candidate,"unified_ypal_20261023_v1".arena_tournament,
  "unified_ypal_20261023_v1".arena_credit TO "arena_native_reader";
GRANT SELECT ON yunipals_indexer_control.release,
  yunipals_indexer_control.chain_status,yunipals_indexer_control.chain_anchor,
  yunipals_indexer_control.transaction_evidence TO "arena_native_reader";
COMMIT;
