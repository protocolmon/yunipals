[Unit]
Description=Yunipals portal API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portal-api
Group=portal-artifacts
WorkingDirectory=@RELEASE_DIRECTORY@/apps/yunipals-indexer
EnvironmentFile=@SERVICE_ENV_FILE@
ExecStart=@NODE_BINARY@ --import tsx scripts/portal-api.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=@ARTIFACT_DIRECTORY@

[Install]
WantedBy=multi-user.target
