[Unit]
Description=Verify existing Yunipals budget policy hashes using read-only SQL
After=postgresql@16-yunipals_market_production.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/python3 -B /opt/yunipals-unified/shared-health/production-health-probe.py --kind budget --configuration /etc/yunipals-unified/shared-production/health.public.json --output-directory /var/lib/yunipals-shared-budget-health
StateDirectory=yunipals-shared-budget-health
StateDirectoryMode=0755
TimeoutStartSec=80
MemoryMax=268435456
TasksMax=32
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
