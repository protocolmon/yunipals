[Unit]
Description=Read-only native health for all thirteen shared Yunipals sources
After=postgresql@16-main.service yunipals-indexer.service yunipals-indexer-observer.service

[Service]
Type=oneshot
User=yunipals_unified_support
Group=yunipals_unified_support
Environment=UNIFIED_INDEXER_DATABASE_URL=postgresql:///yunipals_backfill?host=/var/run/postgresql&port=5432&user=yunipals_unified_support
ExecStart=/usr/bin/python3 -B /opt/yunipals-unified/shared-health/production-health-probe.py --kind source --configuration /etc/yunipals-unified/shared-production/health.public.json --output-directory /var/lib/yunipals-shared-source-health
StateDirectory=yunipals-shared-source-health
StateDirectoryMode=0755
TimeoutStartSec=80
MemoryMax=536870912
TasksMax=32
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
