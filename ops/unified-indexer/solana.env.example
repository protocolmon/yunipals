# Private Solana child configuration. Copy to apps/yunipals-indexer/.env.solana
# locally, or /etc/yunipals-unified/solana.env for a system service.
DATABASE_URL=postgresql://solana:replace-me@127.0.0.1:5432/yunipals
HELIUS_API_KEY=REPLACE_WITH_HELIUS_KEY
SOLANA_SYNC_ENABLED=true
METADATA_SOURCE_MODE=archive
# Keep these within the provider subscription's available allowance.
SOLANA_RPC_DAILY_CREDIT_LIMIT=15000
SOLANA_RPC_ROLLING_31D_CREDIT_LIMIT=500000
SOLANA_MAX_MISSING=0
SOLANA_BATCH_SIZE=1000
SOLANA_SYNC_INTERVAL_MS=900000
