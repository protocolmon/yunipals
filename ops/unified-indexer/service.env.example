# Public supervisor settings. Relative paths resolve beside this file.
# Copy to .env.service for local use. Credentials belong in the child files.
YUNIPALS_INDEXER_PONDER_ENV_FILE=../../apps/yunipals-indexer/.env
UNIFIED_SOLANA_ENABLED=true
YUNIPALS_INDEXER_SOLANA_ENV_FILE=../../apps/yunipals-indexer/.env.solana
UNIFIED_PONDER_PORT=9010
UNIFIED_PONDER_HOSTNAME=127.0.0.1
# Optional existing Ponder schema (SQL identifier, at most 45 characters).
# UNIFIED_PONDER_SCHEMA=yunipals
# Optional installed application directories; both default to this checkout.
# YUNIPALS_INDEXER_PONDER_DIRECTORY=/srv/yunipals/apps/yunipals-indexer
# YUNIPALS_INDEXER_SOLANA_DIRECTORY=/srv/yunipals/apps/yunipals-indexer
# Optional Ponder env overlays, loaded after its private base file in this order.
# YUNIPALS_INDEXER_PONDER_RUNTIME_ENV_FILE=/etc/yunipals-unified/runtime.env
# YUNIPALS_INDEXER_PONDER_OVERRIDE_ENV_FILE=/etc/yunipals-unified/source.env
# YUNIPALS_INDEXER_PONDER_REPLAY_ENV_FILE=/etc/yunipals-unified/replay.env
YUNIPALS_INDEXER_SHUTDOWN_GRACE_MS=30000
