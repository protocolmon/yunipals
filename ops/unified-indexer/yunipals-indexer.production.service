[Unit]
Description=Unified Yunipals shared EVM and Solana ingestion
After=network-online.target postgresql@16-main.service yunipals-shared-rpc@ethereum.service yunipals-shared-rpc@base.service yunipals-shared-rpc@polygon.service yunipals-shared-rpc@bnb.service
Wants=network-online.target yunipals-shared-rpc@ethereum.service yunipals-shared-rpc@base.service yunipals-shared-rpc@polygon.service yunipals-shared-rpc@bnb.service
Requires=postgresql@16-main.service
Conflicts=yunipals-ypal-combined-source.service yunipals-unified-source6-free-v2.service yunipals-solana.service yunipals-booster-ypal-source.service yunipals-booster-launch.service yunipals-bnb.service yunipals-islands-indexer.service yunipals-base-islands-v2.service yunipals-anime-native-source.service yunipals-arena-modes-source.service yunipals-shared-transition-candidate.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=yunipals_unified_shadow
Group=yunipals_unified_shadow
WorkingDirectory=/
Environment=
EnvironmentFile=
UnsetEnvironment=DATABASE_URL DATABASE_PRIVATE_URL HELIUS_API_KEY
ExecStart=/opt/node-v24.18.1/bin/node /opt/yunipals-unified/indexer/scripts/start-indexer.mjs --env-file=/etc/yunipals-unified/indexer.service.env
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=300
RuntimeMaxSec=infinity
RuntimeDirectory=yunipals-indexer
TimeoutStopSec=60
KillMode=control-group
MemoryMax=6442450944
MemorySwapMax=0
TasksMax=128
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=104.18.36.169/32 172.64.151.87/32 2606:4700:440d::6812:24a9/128 2a06:98c1:3104::ac40:9757/128
ReadWritePaths=/var/lib/yunipals-unified-shared
BindReadOnlyPaths=
BindPaths=
UMask=0077

[Install]
WantedBy=multi-user.target
