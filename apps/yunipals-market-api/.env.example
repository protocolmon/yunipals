# Separate staging database. Never reuse the production indexer credentials.
MARKET_DATABASE_URL=postgresql://yunipals_market:change-me@127.0.0.1:55436/yunipals_market_test
MARKET_DEPLOYMENT=staging
MARKET_HOST=127.0.0.1
MARKET_PORT=9012
MARKET_ALLOWED_ORIGINS=http://127.0.0.1:5177
# Local fork admission only; omitted by default and rejected in production.
# Requires an isolated database with fixture indexer relations and a real BNB Anvil fork.
# MARKET_BNB_VALIDATION_RPC=http://127.0.0.1:18647
# Optional browser trading on the verified local fork only; defaults to 0.
# Rejected in production or without the explicit loopback fork above.
# MARKET_BNB_VALIDATION_TRADING=1
# Separate marketplace reconciliation process; bounded from 1 to 8 workers.
MARKET_WORKER_CONCURRENCY=2
# Enable read-only BNB order discovery from the first supported publication block.
# Requires a BNB RPC, the marketplace worker and migrations 22-23; no historical orders are imported.
# MARKET_BNB_DISCOVERY_START_BLOCK=REPLACE_WITH_LAUNCH_BLOCK
# Use a separate schema owner for migration; the API role must not own tables.
# MARKET_MIGRATION_DATABASE_URL=postgresql://schema-owner:...@host/database
