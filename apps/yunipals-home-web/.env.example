# Public service URLs only. Vite embeds these values into the browser bundle.
VITE_YUNIPALS_INDEXER_URL=http://127.0.0.1:9011
VITE_EXOMON_ENABLED=true
VITE_YUNIPALS_MARKETPLACE_URL=http://127.0.0.1:9012
# For independent builds, require explicit operator-owned service URLs.
# VITE_SELF_HOSTED=1
# Public Reown / WalletConnect project ID. Without it, only browser wallets work.
VITE_WALLETCONNECT_PROJECT_ID=

# Enable visibility after the Islands staking API and worker are ready.
VITE_ISLAND_STAKING_ENABLED=false
# Enable wallet withdrawals separately after fork/browser validation.
VITE_ISLAND_UNSTAKE_ENABLED=false

# Optional Mixpanel analytics. All values below are public build-time settings.
# Leave disabled until retention matches the actual project and a privacy contact exists.
VITE_MIXPANEL_ENABLED=false
VITE_MIXPANEL_TOKEN=
VITE_MIXPANEL_REGION=eu
VITE_ANALYTICS_ENVIRONMENT=development
# Set exactly one retention unit to match the actual project policy.
VITE_ANALYTICS_RETENTION_YEARS=
VITE_ANALYTICS_RETENTION_DAYS=
VITE_PRIVACY_EMAIL=
