# Add these settings to the operator's private service environment.
# Reuse OPENAI_API_KEY from the existing OpenAI service configuration.
PORTALS_ENABLED=false
PORTALS_WORKER_ENABLED=false
PORTALS_LEDGER_ENABLED=false
PORTALS_CHAIN_ID=8453
PORTALS_RPC_URL=
# Comma-separated, at most two. Verify every endpoint with portals:preflight-rpc.
PORTALS_RPC_FALLBACK_URLS=
# Maximum blocks per log query (1–2000); match the lowest provider limit.
# The ledger, grading ingestor and RPC preflight use the same range.
PORTALS_LOG_BLOCK_RANGE=2000
# Any known successful transaction on this deployment, used only by read-only preflight.
PORTALS_RPC_PROBE_TRANSACTION=
# Maximum execution gas * maxFeePerGas for one worker transaction, in wei.
# Does not include Base's additional L1 data fee. Keep sufficient signer gas.
PORTALS_MAX_EXECUTION_FEE_WEI=
PORTALS_GRADING_ADDRESS=
PORTALS_DATABASE_URL=
PORTALS_DATABASE_SCHEMA=portal
# Migration identity only. Runtime roles must already exist and be distinct.
PORTALS_API_DATABASE_ROLE=
PORTALS_WORKER_DATABASE_ROLE=
PORTALS_LEDGER_DATABASE_ROLE=
PORTALS_ASSET_DIRECTORY=
PORTALS_PUBLIC_ORIGIN=
PORTALS_ARTWORK_HOSTS=
PORTALS_IPFS_GATEWAY=
PORTALS_START_BLOCK=
PORTALS_CONFIRMATIONS=12
PORTALS_GRADER_PRIVATE_KEY=
# API-only, separate from grader/admin: signs stored-spell acknowledgements, sends no transactions.
# Grant only keccak256("INTAKE_ROLE") on the upgraded grading proxy to this public address.
PORTALS_INTAKE_ADDRESS=
PORTALS_INTAKE_PRIVATE_KEY=
# Retain a worker for each accepted model policy while it has unfinished jobs.
PORTALS_MODEL_POLICIES_JSON=
# Policies may include portalEffects: { "1": { "name": "Rainbow Portal", "instruction": "..." } }.
# Supply the API's matching policy catalog too; older accepted requests keep their old policy.
# Policies may also include portalGradingCases keyed by kind ID; each kind needs its own
# criteria, 1–100 score bands, required checks and partial/missed category ceilings.
# The default v4 adds competitionThemes and retains v1/v2/v3 in the API catalog.
# Its worker publishes winner-derived themes using the grading wallet's THEME_ROLE.
# Run one configured theme policy per deployment; retain older workers for their paid jobs.

# Deployment / unsigned setup preparation. Keep real values in private operator configuration.
PORTALS_ADMIN=
PORTALS_CARDS_ADDRESS=
PORTALS_ENGINE_ADDRESS=
PORTALS_VRF_WRAPPER=
PORTALS_USDC_ADDRESS=
PORTALS_PACK_TYPE_ID=
PORTALS_METADATA_BASE_URI=
PORTALS_CARDS_IMPLEMENTATION=
PORTALS_ENGINE_IMPLEMENTATION=
PORTALS_CARD_START_BLOCK=
PORTALS_AI_RECIPIENT=
PORTALS_GRADER_ADDRESS=
PORTALS_RAINBOW_ART_FILE=
PORTALS_RAINBOW_ART_URI=
PORTALS_RUBRIC_URI=
# Approved source artwork entries: { variantId, uri, path }; all 264 variants exactly once.
PORTALS_BASE_ART_JSON=
# Required only for explicit --execute backfill; unsigned preparation needs no signing key.
PORTALS_ADMIN_PRIVATE_KEY=

# Public ownership/accounting ledger: earliest verified portal-stack deployment block.
PORTALS_LEDGER_START_BLOCK=
# Dedicated competition proxy; used by unsigned launch setup, not an arbitrary payout wallet.
PORTALS_COMPETITION_ADDRESS=
# CRE receiver deployment uses the network's real forwarder and an approved workflow identity.
PORTALS_CRE_FORWARDER=
PORTALS_CRE_WORKFLOW_OWNER=
# bytes32 encoding of the documented CRE bytes10 workflow name, right-padded with zeroes.
PORTALS_CRE_WORKFLOW_NAME=

# Provision the artifact directory with worker ownership, a shared API-read group,
# and mode 2750 before using separate service users. Existing files need group read.
PORTALS_ASSET_SHARED_READ=false

# Dedicated API process (only its intake key; no grader or AI secrets).
PORTALS_ALLOWED_ORIGINS=https://app.example.test
PORTALS_BIND_HOST=127.0.0.1
PORTALS_PORT=8931

# Shared production event ingestion. Legacy is only for transition/rollback or isolated rehearsals.
PORTALS_INDEXER_MODE=unified
# Read-only login to the shared indexer database, separate from private job storage.
PORTALS_INDEXER_DATABASE_URL=
PORTALS_INDEXER_RELEASE_ID=
PORTALS_INDEXER_READ_SCHEMA=
PORTALS_COMPETITION=
# Shared ingestor ONLY: all four {address,startBlock} entries; no signing or AI secrets.
UNIFIED_PORTALS_JSON=
