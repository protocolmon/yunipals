{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["ponder.config.ts", "ponder.schema.ts", "ponder-env.d.ts", "src", "lib", "scripts", "test"]
}
