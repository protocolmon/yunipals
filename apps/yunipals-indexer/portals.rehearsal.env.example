# Private operator configuration for isolated Base Sepolia tests.
# Set PORTALS_REHEARSAL_ENV_FILE to this file's actual private location.
# Do not put real keys or operator paths in the tracked example.
PORTALS_RPC_URL=
PORTALS_VRF_WRAPPER=
PORTALS_REHEARSAL_DIRECTORY=
PORTALS_REHEARSAL_ARTIFACT_DIRECTORY=
PORTALS_REHEARSAL_VARIANTS_FILE=
PORTALS_REHEARSAL_RAINBOW_FILE=
PORTALS_REHEARSAL_MAX_SPEND_ETH=0.003
# HTTPS-shaped references for the in-process private API; not production hosting.
PORTALS_REHEARSAL_ORIGIN=https://portals-rehearsal.invalid

# Dedicated test signers. Never use the public deterministic Anvil keys on a testnet.
PORTALS_REHEARSAL_DEPLOYER_PRIVATE_KEY=
PORTALS_REHEARSAL_PLAYER_PRIVATE_KEY=
PORTALS_REHEARSAL_BUYER_PRIVATE_KEY=

# Reuse already-authorized credentials by referencing private files on their host.
PORTALS_REHEARSAL_AI_ENV_FILE=
PORTALS_REHEARSAL_GRADER_ENV_FILE=
PORTALS_REHEARSAL_DATABASE_ENV_FILE=
# The referenced files provide OPENAI_API_KEY, PORTALS_GRADER_PRIVATE_KEY and
# PORTALS_DATABASE_URL. Use a separate rehearsal database.
PORTALS_GRADER_ADDRESS=
PORTALS_AI_RECIPIENT=
