# Server-only. Install as /etc/yunipals-indexer/request-monitor.env, mode 0600.
# Use a sender/domain approved by your SMTP provider and the intended recipient.
MONITOR_EMAIL_FROM=alerts@example.com
MONITOR_EMAIL_TO=owner@example.com
MONITOR_SMTP_HOST=smtp.example.com
MONITOR_SMTP_PORT=587
MONITOR_SMTP_TLS=starttls
MONITOR_SMTP_USER=
MONITOR_SMTP_PASSWORD=
# For SMTP-over-TLS use MONITOR_SMTP_TLS=implicit and port 465.
