# Server-side configuration only. Keep credentials out of VITE_ variables.
DATABASE_URL=postgresql://indexer:replace-me@127.0.0.1:5432/yunipals
API_HOST=127.0.0.1
PONDER_RPC_URL_1=https://ethereum-rpc.example.invalid
PONDER_RPC_URL_8453=https://base-rpc.example.invalid
PONDER_RPC_URL_137=https://polygon-rpc.example.invalid
PONDER_RPC_URL_56=https://bnb-rpc.example.invalid
# The combined Ponder config indexes all four chains, including BNB. Start it
# against a fresh candidate DATABASE_SCHEMA during the unified migration.
# Keep existing production scanners/readers until parity and cutover gates pass.
# Optional read-only Base Arena sources; this process never loads signer keys.
# UNIFIED_ARENA_DEPLOYMENTS=[{"address":"0xREPLACE_WITH_DEPLOYED_ARENA","startBlock":123}]
# Optional BNB Seaport discovery start; leave unset to subscribe to no addresses.
# MARKET_BNB_DISCOVERY_START_BLOCK=REPLACE_WITH_VERIFIED_DISCOVERY_START
# Separate support process: point at the candidate's database with its support
# writer role. Ponder keeps its own write role; read APIs use read-only roles.
# UNIFIED_INDEXER_DATABASE_URL=postgresql://support:replace-me@127.0.0.1:5432/yunipals_candidate
# UNIFIED_INDEXER_SCHEMA=yunipals_unified_candidate
# UNIFIED_INDEXER_BUILD_ID=REPLACE_WITH_VERIFIED_PONDER_BUILD_ID
# UNIFIED_INDEXER_RELEASE_ID=REPLACE_WITH_REGISTERED_CANDIDATE_DIGEST
# Fresh candidate ownership read schema; creating it does not select it for APIs.
# UNIFIED_INDEXER_READ_SCHEMA=yunipals_unified_ownership_candidate
# Include the verified Base Islands v2 replacement in the unified source.
# UNIFIED_BASE_ISLANDS_V2_ENABLED=true
BNB_RPC_URL=https://bnb-rpc.example.invalid
BNB_DATABASE_SCHEMA=bnb_indexer
READ_DATABASE_SCHEMA=yunipals_read_v4
# Candidate API/metadata/cache readers only. Leave legacy until cutover acceptance.
OWNERSHIP_READ_MODE=legacy
# Unified mode requires generation projections, a distinct physical DATABASE_SCHEMA,
# the immutable candidate view schema, and its registered release digest.
# OWNERSHIP_READ_MODE=unified
# OWNERSHIP_READ_SCHEMA=yunipals_unified_ownership_candidate
# OWNERSHIP_RELEASE_ID=0xREPLACE_WITH_REGISTERED_CANDIDATE_DIGEST
# READ_DATABASE_SCHEMA=yunipals_unified_ownership_candidate
# YUNIPALS_PROJECTION_MODE=generation
BNB_CONFIRMATIONS=20
BNB_LOG_BLOCK_RANGE=100000
BNB_RECONCILE_MS=300000
METADATA_SOURCE_MODE=legacy-http
# Archive metadata readers/workers: keep rpc until migration acceptance.
# unified = retained finalized-page mirror; native = latest native journal views.
BASE_METADATA_INGESTION=rpc
# With unified ingestion, UNIFIED_INDEXER_DATABASE_URL uses a read-only role.
# Keep UNIFIED_INDEXER_RELEASE_ID pinned during candidate testing/adoption.
# Native mode requires the unified ownership settings above and archive mode.
# Use a fresh version-3 view schema, apply db:migrate, compare historical data,
# stop the old writers and explicitly run --command native-adopt at cutover.
# BASE_METADATA_INGESTION=native
# METADATA_SOURCE_MODE=archive
RARITY_READ_SOURCE=metadata
API_COLLECTOR_FILTERS_ENABLED=false
API_COLLECTOR_NAME_SEARCH_ENABLED=false
API_COLLECTOR_RARITY_RANGE_ENABLED=false

# Exomon snapshot API and shared-service Solana adapter. Preserve the deployed
# archive manifest, missing-asset policy and credit limits during migration.
SOLANA_API_ENABLED=false
SOLANA_SYNC_ENABLED=false
# HELIUS_API_KEY belongs only in the private Solana child environment file.
# SOLANA_BATCH_SIZE=1000
# SOLANA_SYNC_INTERVAL_MS=900000
# SOLANA_MAX_MISSING=REUSE_VERIFIED_PRODUCTION_SETTING
# SOLANA_RPC_DAILY_CREDIT_LIMIT=REUSE_VERIFIED_PRODUCTION_SETTING
# SOLANA_RPC_ROLLING_31D_CREDIT_LIMIT=REUSE_VERIFIED_PRODUCTION_SETTING

# Enable Islands reads after replay, db:migrate, start:islands-metadata,
# and islands:verify --activate have completed on the candidate schema.
API_ISLANDS_ENABLED=false
ISLANDS_METADATA_CONCURRENCY=8
ISLANDS_METADATA_AUDIT_SECONDS=3600
ISLANDS_METADATA_MAX_BYTES=1048576

# Isolated production deployment: use a fresh DATABASE_SCHEMA, the Islands
# Ponder config, islands:migrate, and start:islands-api (API_PORT defaults to 9015).
# Keep this false for the combined ponder.config.ts.
PONDER_ISLANDS_ONLY=false

# Enable only after api:read-cache:migrate and start:read-cache are running in generation mode.
YUNIPALS_READ_CACHE=0

# Optional booster collection (leave addresses empty until deployed)
BOOSTER_REGISTRY=
BOOSTER_ENGINE=
BOOSTER_MONSTERS=
BOOSTER_WRAPPER=
BOOSTER_DEPLOYMENT_BLOCK=
# Schema of the optional isolated Base booster indexer
BOOSTER_DATABASE_SCHEMA=

# Persistent approved variant assets/catalogs and deduplicated Codex job queue.
# API serves read-only metadata/assets; worker queues indexed missing variants.
# BOOSTER_ARTWORK_DIRECTORY=/srv/yunipals/booster-artwork
# BOOSTER_ARTWORK_CATALOGS=base-mainnet-smoke-v1
