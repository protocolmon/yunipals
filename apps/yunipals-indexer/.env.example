# Private Ponder child configuration. Copy to .env and restrict to its owner.
# Node loads this file only in the EVM child; the parent never reads its values.
DATABASE_URL=postgresql://indexer:replace-me@127.0.0.1:5432/yunipals

# RPC budget proxy endpoints for the four indexed chains.
PONDER_RPC_URL_1=http://127.0.0.1:19201/unified
PONDER_RPC_URL_8453=http://127.0.0.1:19202/unified
PONDER_RPC_URL_137=http://127.0.0.1:19203/unified
PONDER_RPC_URL_56=http://127.0.0.1:19204/unified
UNIFIED_RPC_PROFILE_FILE=/etc/yunipals-unified/rpc/profile.json
UNIFIED_RPC_PROFILE_ID=REPLACE_WITH_0x_PROFILE_ID
# Historical replay uses explicit bounded allowances from the RPC coordinator.
# UNIFIED_RPC_REPLAY_PERMIT_ID_1=REPLACE_WITH_0x_PERMIT_ID
# UNIFIED_RPC_REPLAY_PERMIT_ID_8453=REPLACE_WITH_0x_PERMIT_ID
# UNIFIED_RPC_REPLAY_PERMIT_ID_137=REPLACE_WITH_0x_PERMIT_ID
# UNIFIED_RPC_REPLAY_PERMIT_ID_56=REPLACE_WITH_0x_PERMIT_ID

# Optional deployed sources. Configure these before the first start and retain
# the same source configuration when restarting an existing database.
# UNIFIED_BASE_ISLANDS_V2_ENABLED=true
# UNIFIED_ARENA_DEPLOYMENTS=[{"address":"0xREPLACE_WITH_DEPLOYED_ARENA","startBlock":123}]
# MARKET_BNB_DISCOVERY_START_BLOCK=123
BOOSTER_REGISTRY=
BOOSTER_ENGINE=
BOOSTER_MONSTERS=
BOOSTER_WRAPPER=
BOOSTER_DEPLOYMENT_BLOCK=
